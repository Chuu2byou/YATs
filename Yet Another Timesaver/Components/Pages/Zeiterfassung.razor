@page "/Time Booking"

@using Yet_Another_Timesaver.Backend
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer

<PageTitle>Time Booking</PageTitle>

<div class="app-page">

    @* Seitenüberschrift *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <RadzenText Text="Time Booking"
                        TextStyle="TextStyle.H4" />

            <RadzenText Text="Manage and track your working hours."
                        TextStyle="TextStyle.Body2" />
        </div>

        <RadzenButton Text="Refresh"
                      Icon="refresh"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@RefreshData" />
    </div>


    @* Übersichtskarten *@
	<RadzenRow Gap="16px">

		<RadzenColumn Size="12" SizeMD="4">
			<RadzenCard class="overview-card">
				<div class="overview-card-content">
					<div>
						<RadzenText Text="Today"
									TextStyle="TextStyle.Subtitle2" />

						<RadzenText Text="@TodayHours"
									TextStyle="TextStyle.H4" />

						<RadzenText Text="Recorded working time"
									TextStyle="TextStyle.Caption" />
					</div>

					<div class="overview-card-icon today-icon">
						<i class="bi bi-clock-history"></i>
					</div>
				</div>
			</RadzenCard>
		</RadzenColumn>

		<RadzenColumn Size="12" SizeMD="4">
			<RadzenCard class="overview-card">
				<div class="overview-card-content">
					<div>
						<RadzenText Text="This Week"
									TextStyle="TextStyle.Subtitle2" />

						<RadzenText Text="@WeekHours"
									TextStyle="TextStyle.H4" />

						<RadzenText Text="Total weekly working time"
									TextStyle="TextStyle.Caption" />
					</div>

					<div class="overview-card-icon week-icon">
						<i class="bi bi-calendar-week"></i>
					</div>
				</div>
			</RadzenCard>
		</RadzenColumn>

		<RadzenColumn Size="12" SizeMD="4">
			<RadzenCard class="overview-card">
				<div class="overview-card-content">
					<div>
						<RadzenText Text="Current Status"
									TextStyle="TextStyle.Subtitle2" />

						<RadzenText Text="@WorkStatus"
									TextStyle="TextStyle.H4" />

						<RadzenText Text="@StatusDescription"
									TextStyle="TextStyle.Caption" />
					</div>

					<div class="overview-card-icon status-icon">
						<i class="bi bi-activity"></i>
					</div>
				</div>
			</RadzenCard>
		</RadzenColumn>

	</RadzenRow>


    @* Arbeitszeit starten und beenden *@
	<RadzenCard class="mt-4 working-time-card">

		<div class="working-time-header">
			<div>
				<RadzenText Text="Working Time"
							TextStyle="TextStyle.H5" />

				<RadzenText Text="@CurrentDate"
							TextStyle="TextStyle.Body2" />
			</div>

			<div class="working-time-indicator">
				<i class="bi bi-clock"></i>
			</div>
		</div>

		<div class="working-time-content">

			<div class="time-info">
				<div class="time-info-item">
					<RadzenText Text="Start Time"
								TextStyle="TextStyle.Caption" />

					<div class="time-value">
						<i class="bi bi-play-circle"></i>
						<RadzenText Text="@StartTime"
									TextStyle="TextStyle.H5" />
					</div>
				</div>

				<div class="time-info-item">
					<RadzenText Text="End Time"
								TextStyle="TextStyle.Caption" />

					<div class="time-value">
						<i class="bi bi-stop-circle"></i>
						<RadzenText Text="@EndTime"
									TextStyle="TextStyle.H5" />
					</div>
				</div>
			</div>

			<div class="working-time-action">
				@if (!IsWorking)
				{
					<RadzenButton Text="Clock In"
								  Icon="play_arrow"
								  ButtonStyle="ButtonStyle.Primary"
								  Click="@StartWork" />
				}
				else
				{
					<RadzenButton Text="Clock Out"
								  Icon="stop"
								  ButtonStyle="ButtonStyle.Danger"
								  Click="@StopWork" />
				}
			</div>

		</div>

	</RadzenCard>


    @* Zeiteinträge *@
	<RadzenCard class="mt-4 time-entries-card">

		<div class="time-entries-header">
			<div>
				<RadzenText Text="My Time Entries"
							TextStyle="TextStyle.H5" />

				<RadzenText Text="Overview of your recorded working hours"
							TextStyle="TextStyle.Body2" />
			</div>

			<RadzenDatePicker @bind-Value="SelectedDate"
							  DateFormat="dd.MM.yyyy"
							  Placeholder="Select Date" />
		</div>

		<RadzenDataGrid Data="@Entries"
						TItem="TimeEntry"
						AllowPaging="true"
						PageSize="5"
						AllowSorting="true"
						EmptyText="No time entries available."
						class="time-entries-grid">

			<Columns>

				<RadzenDataGridColumn TItem="TimeEntry"
									  Property="StartTime"
									  Title="Date"
									  FormatString="{0:dd.MM.yyyy}" />

				<RadzenDataGridColumn TItem="TimeEntry"
									  Property="StartTime"
									  Title="Start"
									  FormatString="{0:HH:mm}" />

				<RadzenDataGridColumn TItem="TimeEntry"
									  Property="EndTime"
									  Title="End"
									  FormatString="{0:HH:mm}" />

				<RadzenDataGridColumn TItem="TimeEntry"
									  Property="Description"
									  Title="Description" />

				<RadzenDataGridColumn TItem="TimeEntry"
									  Title="Actions"
									  Sortable="false"
									  Filterable="false">

					<Template Context="entry">
						<RadzenButton Icon="delete"
									  ButtonStyle="ButtonStyle.Danger"
									  Variant="Variant.Text"
									  Size="ButtonSize.Small"
									  Click="@(() => DeleteEntry(entry))" />
					</Template>

				</RadzenDataGridColumn>

			</Columns>

		</RadzenDataGrid>

	</RadzenCard>
		
</div>
