@page "/time-tracking"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Yet_Another_Timesaver.Backend
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer

<PageTitle>Time Tracking</PageTitle>

<div class="app-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <RadzenText Text="Time Tracking"
                        TextStyle="TextStyle.H4"/>

            <RadzenText Text="Keep your working hours in view."
                        TextStyle="TextStyle.Body2"/>
        </div>

        <RadzenButton Text="Refresh"
                      Icon="refresh"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@RefreshData"/>
    </div>


    <RadzenRow Gap="16px">

        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard>
                <RadzenText Text="Today"
                            TextStyle="TextStyle.Subtitle2"/>

                <RadzenText Text="@TodayHours"
                            TextStyle="TextStyle.H4"/>

                <RadzenText Text="Hours recorded today"
                            TextStyle="TextStyle.Caption"/>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard>
                <RadzenText Text="This week"
                            TextStyle="TextStyle.Subtitle2"/>

                <RadzenText Text="@WeekHours"
                            TextStyle="TextStyle.H4"/>

                <RadzenText Text="Total hours this week"
                            TextStyle="TextStyle.Caption"/>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard>
                <RadzenText Text="Current status"
                            TextStyle="TextStyle.Subtitle2"/>

                <RadzenText Text="@WorkStatus"
                            TextStyle="TextStyle.H4"/>

                <RadzenText Text="@StatusDescription"
                            TextStyle="TextStyle.Caption"/>
            </RadzenCard>
        </RadzenColumn>

    </RadzenRow>


    <RadzenCard class="mt-4">

        <RadzenText Text="Work session"
                    TextStyle="TextStyle.H5"/>

        <RadzenText Text="@CurrentDate"
                    TextStyle="TextStyle.Body2"/>

        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">

            <div>
                <RadzenText Text="Start time"
                            TextStyle="TextStyle.Caption"/>

                <RadzenText Text="@StartTime"
                            TextStyle="TextStyle.H5"/>
            </div>

            <div>
                <RadzenText Text="End time"
                            TextStyle="TextStyle.Caption"/>

                <RadzenText Text="@EndTime"
                            TextStyle="TextStyle.H5"/>
            </div>

            <div class="ms-md-auto">
                @if (!IsWorking)
                {
                    <RadzenButton Text="Start work"
                                  Icon="play_arrow"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@StartWork"/>
                }
                else
                {
                    <RadzenButton Text="End work"
                                  Icon="stop"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@StopWork"/>
                }
            </div>

        </div>

    </RadzenCard>


    <RadzenCard class="mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <RadzenText Text="My time entries"
                        TextStyle="TextStyle.H5"/>

            <div class="d-flex align-items-center gap-2">
                <RadzenDatePicker @bind-Value="SelectedDate"
                                  DateFormat="dd.MM.yyyy"
                                  Placeholder="Select date"/>

                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Flat"
                              Size="ButtonSize.Small"
                              Click="@(() => SelectedDate = null)"
                              title="Show all entries"/>
            </div>
        </div>

        <RadzenDataGrid Data="@FilteredEntries"
                        TItem="TimeEntry"
                        AllowPaging="true"
                        PageSize="5"
                        AllowSorting="true"
                        EmptyText="No time entries found.">

            <Columns>

                <RadzenDataGridColumn TItem="TimeEntry"
                                      Property="StartTime"
                                      Title="Date"
                                      FormatString="{0:dd.MM.yyyy}"/>

                <RadzenDataGridColumn TItem="TimeEntry"
                                      Property="StartTime"
                                      Title="Start"
                                      FormatString="{0:HH:mm}"/>

                <RadzenDataGridColumn TItem="TimeEntry"
                                      Property="EndTime"
                                      Title="End"
                                      FormatString="{0:HH:mm}"/>

                <RadzenDataGridColumn TItem="TimeEntry"
                                      Property="Description"
                                      Title="Description"/>

                <RadzenDataGridColumn TItem="TimeEntry"
                                      Title="Actions"
                                      Sortable="false"
                                      Filterable="false">

                    <Template Context="entry">
                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"
                                      Size="ButtonSize.Small"
                                      Click="@(() => DeleteEntry(entry))"/>
                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</div>
