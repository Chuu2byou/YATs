@page "/calendar"
@using Yet_Another_Timesaver.Backend;
@rendermode InteractiveServer
@inject DialogService DialogService

<RadzenScheduler @ref=@scheduler TItem="TimeEntry" Data=@TimeEntries
                 StartProperty="StartTime" EndProperty="EndTime" TextProperty="Description"
                 SelectedIndex="2" style="width: 100%; height: calc(100vh - 120px);"
                 SlotSelect=@OnSlotSelect AppointmentSelect=@OnTimeEntrySelect
                 AppointmentRender=@OnTimeEntryRender SlotRender=@OnSlotRender
                 AppointmentMove=@OnTimeEntryMove AppointmentResize=@OnTimeEntryResize>
    <NavigationTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
            <RadzenButton Icon="add" Text="New" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Click=@CreateTimeBooking/>
            <RadzenSelectBar TValue="int" Value=@selectedView Change=@OnViewChange Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Value="0" Text="Day" Icon="calendar_view_day"/>
                    <RadzenSelectBarItem Value="1" Text="Week" Icon="calendar_view_week"/>
                    <RadzenSelectBarItem Value="2" Text="Month" Icon="calendar_view_month"/>
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </NavigationTemplate>
    <ChildContent>
        <RadzenDayView @ref=@dayView/>
        <RadzenWeekView @ref=@weekView/>
        <RadzenMonthView @ref=@monthView/>
    </ChildContent>
</RadzenScheduler>

@*<EventConsole @ref=@console/>*@
