@inject DialogService DialogService
@using Yet_Another_Timesaver.Backend;
@rendermode InteractiveServer

<RadzenTemplateForm TItem="TimeEntry" Data="@model" Submit=@OnSubmit>
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Title" Style="width: 6rem;" />
            <RadzenTextBox @bind-Value="@model.Description" Name="Description" Style="width: 12rem;" />
            <RadzenRequiredValidator Component="Description" Text="Title is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Start" Style="width: 6rem;" />
            <RadzenDatePicker @bind-Value="@model.StartTime" Name="StartTime" ShowTime="true" Style="width: 12rem;" />
            <RadzenRequiredValidator Component="StartTime" Text="Start is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="End" Style="width: 6rem;" />
            <RadzenDatePicker Name="EndTime" @bind-Value="@model.EndTime" ShowTime="true" Style="width: 12rem;" />
            <RadzenRequiredValidator Component="EndTime" Text="End is required" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" >
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>
